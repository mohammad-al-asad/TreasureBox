# ==========================================
# TREASUREBOX BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/treasurebox
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/treasurebox?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/treasurebox

# Frontend Admin Dashboard URL (Used for CORS whitelist)
CLIENT_URL=http://localhost:3000

# Authentication & JWT Security
# Use strong random strings in production
JWT_SECRET=supersecretaccesskeyfortreasureboxbackenddev123
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=supersecretrefreshkeyfortreasureboxbackenddev123
JWT_REFRESH_EXPIRES_IN=30d

# Mailer & Email Verification (Nodemailer)
# Gmail: host=smtp.gmail.com, port=587, user=your_gmail, pass=your_16_char_google_app_password
# Mailtrap (for testing): host=smtp.mailtrap.io, port=2525
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_user
SMTP_PASS=dummy_pass
FROM_EMAIL=no-reply@treasurebox.com

# Cloudinary Media Storage (For hunt images & claim proof photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Services
# Redis (Optional for caching/rate-limiting)
# REDIS_URL=redis://127.0.0.1:6379

# PayPal Payment Gateway Configuration (v2 Checkout REST API)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # Use 'sandbox' for testing, 'live' for production

