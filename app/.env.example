# ============================================
# TREASUREBOX MOBILE APP ENVIRONMENT VARIABLES
# ============================================

# Backend API Base URL
# - Web / Localhost: http://localhost:5000/api/v1
# - Android Emulator: http://10.0.2.2:5000/api/v1
# - Physical Device over Wi-Fi (Expo Go): http://<YOUR_LOCAL_IP>:5000/api/v1
# - Production API: https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Runtime Mode (development | production)
EXPO_PUBLIC_ENV=development

# Google Maps API Key (for Static Maps rendering in LocationMapScreen)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable: Maps Static API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
