{
  "expo": {
    "name": "Treasure Box",
    "slug": "treasure-box",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.treassurebox",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "ar": "./locales/ar.json"
    },
    "android": {
      "package": "com.treassurebox",
      "adaptiveIcon": {
        "backgroundColor": "#0D2823",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph the treasure you found.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach a picture of the treasure you found.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D2823"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd45d9ec-451a-4ea2-8f69-bba750981cb6"
      }
    },
    "owner": "treasure-box-app"
  }
}
